# Canonical Site URL (Used for sitemaps, robots.txt, metadataBase, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://zenvuk.com

# Headless WordPress CMS REST API
WORDPRESS_API_URL=https://cms.zenvuk.com/wp-json/wp/v2

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# If left empty, Google Analytics scripts are not injected
NEXT_PUBLIC_GA_ID=

# Google AdSense Monetization (Strictly disabled by default until approval)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: Manual Ad Units for Tools
NEXT_PUBLIC_AD_SLOT_TOOL_AFTER=
NEXT_PUBLIC_AD_SLOT_TOOL_MIDDLE=
NEXT_PUBLIC_AD_SLOT_TOOL_END=

# Optional: Manual Ad Units for Blog Articles
NEXT_PUBLIC_AD_SLOT_BLOG_AFTER_INTRO=
NEXT_PUBLIC_AD_SLOT_BLOG_MIDDLE=
NEXT_PUBLIC_AD_SLOT_BLOG_END=

# Optional: Server-side ads.txt entry (e.g. google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0)
ADSENSE_ADS_TXT=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Future Local Open-Source AI (Default OFF)
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
